#version 430

// Copies world-terrain opacity into the flood's solid bitmap.
//
// VsShipLightStorage already collects `canOcclude() && isShapeFullBlock` per world section, caches it
// across frames, and invalidates on light updates, so this pass just moves those bits into the
// working layout once per frame. Baking here rather than looking terrain up inside the flood turns a
// LUT walk per voxel per iteration into a single LUT walk per voxel.

layout(local_size_x = 256) in;

#include "vs_light_common.glsl"

uniform int u_ActiveCount;

// One LUT walk per WORKGROUP, not per voxel.
//
// vs_findWorldSection depends only on the section, and a section is 4096 voxels while a workgroup is
// 256 -- and 4096 is a whole multiple of 256, so a workgroup never straddles two sections. Resolving
// it per voxel was 4096 identical three-level LUT walks per section, every frame.
shared int s_worldSlot;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    // NOTE: no early return before the barrier below -- every thread in the group must reach it.
    bool inRange = gid < uint(u_ActiveCount) * VS_CORE_VOXELS;

    uint si = gid >> 12u;
    uint v = gid & (VS_CORE_VOXELS - 1u);

    ivec4 slotPos = vs_slotPos[min(si, uint(max(u_ActiveCount - 1, 0)))];
    int slot = slotPos.x;
    ivec3 sectionPos = slotPos.yzw;

    if (gl_LocalInvocationID.x == 0u) {
        s_worldSlot = vs_findWorldSection(sectionPos);
    }
    barrier();
    int worldSlot = s_worldSlot;
    if (!inRange || worldSlot < 0) return;

    ivec3 c = vs_coreCoords(v);
    // +1 on each axis skips the packed layout's leading border row.
    uint bitOffset = uint((c.x + 1) + (c.z + 1) * 18 + (c.y + 1) * 324);
    uint word = vs_worldSections[uint(worldSlot) * VS_SECTION_SIZE_INTS + (bitOffset >> 5u)];
    if ((word & (1u << (bitOffset & 31u))) == 0u) return;

    atomicOr(vs_solid[uint(slot) * VS_CORE_SOLID_INTS + (v >> 5u)], 1u << (v & 31u));
}
